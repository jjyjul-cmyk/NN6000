config wifi-device 'radio0'
        option type 'mac80211'
        option phy 'phy0'
        option band '5g'
        option channel 'auto'
        option htmode 'HE80'
        option country 'CN'
        option disabled '0'

config wifi-device 'radio1'
        option type 'mac80211'
        option phy 'phy1'
        option band '2g'
        option channel 'auto'
        option htmode 'HE20'
        option country 'CN'
        option disabled '0'

config wifi-iface 'default_radio0'
        option device 'radio0'
        option network 'lan'
        option mode 'ap'
        option ssid 'NN6000-OPEN'
        option encryption 'none'
        option disabled '0'

config wifi-iface 'default_radio1'
        option device 'radio1'
        option network 'lan'
        option mode 'ap'
        option ssid 'NN6000-OPEN'
        option encryption 'none'
        option disabled '0'
