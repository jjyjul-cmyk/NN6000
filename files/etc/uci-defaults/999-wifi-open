#!/bin/sh
# 首次启动强制生成/恢复开放 AP 接口。
# 序号 999 保证在 fork 自带的 998-wireless-set 之后执行，避免 SSID 被覆盖。
[ -x /sbin/wifi ] || exit 0

if ! uci show wireless 2>/dev/null | grep -q 'wifi-device'; then
        wifi detect > /etc/config/wireless
fi

uci -q batch <<-EOF >/dev/null 2>&1
        set network.lan.ipaddr='192.168.5.1'
        set network.lan.netmask='255.255.255.0'
        set wireless.@wifi-device[0].disabled='0'
        set wireless.@wifi-device[0].country='CN'
        set wireless.@wifi-device[1].disabled='0'
        set wireless.@wifi-device[1].country='CN'
        set wireless.@wifi-iface[0].device='radio0'
        set wireless.@wifi-iface[0].network='lan'
        set wireless.@wifi-iface[0].mode='ap'
        set wireless.@wifi-iface[0].ssid='NN6000-OPEN'
        set wireless.@wifi-iface[0].encryption='none'
        set wireless.@wifi-iface[1].device='radio1'
        set wireless.@wifi-iface[1].network='lan'
        set wireless.@wifi-iface[1].mode='ap'
        set wireless.@wifi-iface[1].ssid='NN6000-OPEN'
        set wireless.@wifi-iface[1].encryption='none'
        commit network
        commit wireless
EOF

wifi reload >/dev/null 2>&1
exit 0
